# MediBond BD Release Signing Configuration Template
# Instructions:
# 1. Generate release keystore:
#    keytool -genkey -v -keystore release-key.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
# 2. Copy this file to android/key.properties and populate secret fields:
#    storePassword=<your-store-password>
#    keyPassword=<your-key-password>
#    keyAlias=upload
#    storeFile=../release-key.jks
# 3. DO NOT COMMIT key.properties or release-key.jks to Git repository!

storePassword=YOUR_STORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=upload
storeFile=../release-key.jks
